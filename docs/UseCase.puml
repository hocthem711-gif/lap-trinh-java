title Sơ Đồ Ca Sử Dụng (Use Case Diagram) — Hệ Thống Smart Farm IoT & UAV\n[Sprint 1–8][Dev 5] LTJ-5

' ===== TÁC NHÂN BÊN TRÁI =====
actor "Farm Administrator\n(Quản trị viên nông trại)" as Admin #82E0AA

' ===== RANH GIỚI HỆ THỐNG =====
rectangle "Hệ thống Nền tảng IoT & UAV Giám sát Nông trại" {

    package "1. Quản trị & Giám sát Nông trại" as PKG_FARM #F8F9F9 {
        usecase "F02: Quản lý tài khoản người dùng" as UC02
        usecase "F03: Quản lý Nông trại & Khu vực (Zone)" as UC03
        usecase "F04: Xem Dashboard tổng quan" as UC04
        usecase "F05: Xem bản đồ vị trí & trạng thái cảm biến" as UC05
        usecase "F06: Xem dữ liệu hiện tại & lịch sử" as UC06
        usecase "F07: So sánh dữ liệu giữa các Zone" as UC07
    }

    package "2. Cảnh báo & Báo cáo" as PKG_ALERT #FEF9E7 {
        usecase "F08: Xem, xác nhận & đóng cảnh báo" as UC08
        usecase "F09: Cấu hình ngưỡng, timeout & pin yếu" as UC09
        usecase "F10: Nhận thông báo Web & Email" as UC10
        usecase "F11: Xuất báo cáo tổng hợp" as UC11
    }

    package "3. Xác thực Truy cập" as PKG_AUTH #EBF5FB {
        usecase "F01: Đăng nhập & Đăng xuất" as UC01
    }

    package "4. Thu thập & Đồng bộ Dữ liệu Biên" as PKG_EDGE #E8F8F5 {
        usecase "F18: Phát hiện & xác thực nút cảm biến" as UC18
        usecase "F19: Thu thập & kiểm tra hợp lệ dữ liệu" as UC19
        usecase "F20: Lưu Offline (SQLite) & tự động đồng bộ" as UC20
    }

    package "5. Quản lý Thiết bị & Nhiệm vụ UAV" as PKG_UAV #FDEDEC {
        usecase "F12: Đăng ký, cập nhật & gán nút cảm biến" as UC12
        usecase "F13: Quản lý UAV & Mobile Gateway" as UC13
        usecase "F14: Tạo nhiệm vụ bay (Mission & Waypoints)" as UC14
        usecase "F15: Giám sát bay & tiến độ Telemetry" as UC15
        usecase "F16: Cập nhật thủ công trạng thái Mission" as UC16
        usecase "F17: Xem lại kết quả & điểm lỗi Mission" as UC17
    }
}

' ===== TÁC NHÂN BÊN PHẢI =====
actor "Sensor Collection Engine\n(UAV Mobile Gateway)" as Engine #F9E79F
actor "IoT Sensor Node\n(Nút cảm biến)" as Sensor #F5B041
actor "UAV & Device Operator\n(Người vận hành UAV & thiết bị)" as Operator #F5CBA7

