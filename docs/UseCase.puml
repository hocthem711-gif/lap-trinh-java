@startuml UseCaseDiagram
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor #F0F8FF
    BorderColor #4682B4
}

title Hệ thống Giám sát IoT - Use Case Diagram\n[Sprint 1][Dev 5] LTJ-5

' ===== Actors =====
actor "Người dùng\n(User)" as User #LightBlue
actor "Quản trị viên\n(Admin)" as Admin #LightGreen
actor "Thiết bị IoT\n(IoT Device)" as IoT #Orange

' ===== Hệ thống =====
rectangle "Hệ thống Giám sát IoT" {

    ' --- Quản lý tài khoản ---
    package "Quản lý Tài khoản" {
        usecase "Đăng nhập" as UC1
        usecase "Đăng ký" as UC2
        usecase "Đổi mật khẩu" as UC3
    }

    ' --- Giám sát ---
    package "Giám sát Dữ liệu" {
        usecase "Xem Dashboard\n(Biểu đồ thông số)" as UC4
        usecase "Xem lịch sử\ndữ liệu cảm biến" as UC5
        usecase "Nhận cảnh báo\n(Alert)" as UC6
    }

    ' --- Điều khiển thiết bị ---
    package "Điều khiển Thiết bị" {
        usecase "Bật / Tắt thiết bị" as UC7
        usecase "Lập lịch\ntự động" as UC8
    }

    ' --- Quản trị ---
    package "Quản trị Hệ thống" {
        usecase "Quản lý người dùng" as UC9
        usecase "Quản lý thiết bị" as UC10
        usecase "Cấu hình ngưỡng\ncảnh báo" as UC11
    }

    ' --- IoT ---
    package "IoT Gateway" {
        usecase "Gửi dữ liệu\ncảm biến (MQTT)" as UC12
        usecase "Nhận lệnh\nđiều khiển" as UC13
    }
}

' ===== Quan hệ Actor -> Use Case =====
User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8

Admin --> UC1
Admin --> UC9
Admin --> UC10
Admin --> UC11

IoT --> UC12
IoT --> UC13

' ===== Quan hệ giữa Use Case =====
UC4 ..> UC1 : <<include>>
UC5 ..> UC1 : <<include>>
UC7 ..> UC1 : <<include>>
UC9 ..> UC1 : <<include>>
UC8 ..> UC7 : <<extend>>
UC6 ..> UC12 : <<include>>

@enduml
