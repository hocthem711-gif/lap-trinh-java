@startuml Component_Diagram
!theme plain
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam componentStyle uml2
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundCorner 10
skinparam shadowing false
skinparam nodesep 32
skinparam ranksep 58
skinparam packageStyle rectangle
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.3
skinparam PackageBorderColor #34495E
skinparam PackageBorderThickness 1.6
skinparam PackageFontSize 14
skinparam PackageFontStyle bold
skinparam ComponentBorderColor #2C3E50
skinparam ComponentFontSize 12
skinparam TitleFontSize 17

title Sơ Đồ Thành Phần Kiến Trúc Hệ Thống (Component Diagram) — Smart Farm IoT & UAV\n[Sprint 1–8][Dev 5] LTJ-15

' =====================================================================
' TẦNG 1: GIAO DIỆN NGƯỜI DÙNG WEB (FRONTEND)
' =====================================================================
package "1. Tầng Giao Diện Người Dùng Web (React 19 · TypeScript · Vite)" as Layer1 #EBF5FB {
    component "Đăng Nhập & Quản Trị\n(Login · Tài khoản & Nông trại)\n[F01 – F03]" as FE_Admin #D6EAF8
    component "Bản Đồ & Biểu Đồ Giám Sát\n(Leaflet Map · Lịch sử · So sánh Zone)\n[F04 – F07]" as FE_Monitor #D6EAF8
    component "Quản Lý Thiết Bị & Nhiệm Vụ UAV\n(Gán cảm biến · Lộ trình bay · Nhật ký)\n[F12 – F17]" as FE_Uav #D6EAF8
    component "Cảnh Báo & Xuất Báo Cáo\n(Cấu hình ngưỡng · Xử lý · Xuất file)\n[F08 – F11]" as FE_Alert #D6EAF8

    component "Bộ Quản Lý Trạng Thái & Kết Nối Mạng\n(Redux Toolkit · Axios REST · WebSocket STOMP / SSE)" as FE_Gateway #AED6F1

    FE_Admin -[hidden]right- FE_Monitor
    FE_Monitor -[hidden]right- FE_Uav
    FE_Uav -[hidden]right- FE_Alert

    FE_Admin ..> FE_Gateway
    FE_Monitor ..> FE_Gateway
    FE_Uav ..> FE_Gateway
    FE_Alert ..> FE_Gateway
}

' =====================================================================
' TẦNG 2: DỊCH VỤ LÕI BACKEND (SPRING BOOT)
' =====================================================================
package "2. Tầng Dịch Vụ Lõi Máy Chủ (Spring Boot 3.2 · Java 17)" as Layer2 #F5EEF8 {
    component "Cổng Bảo Mật JWT & Đẩy Luồng Trực Tiếp\n(SecurityConfig · JwtAuthenticationFilter · TelemetryRealtimeService)" as BE_Security #D7BDE2

    component "Quản Lý Tài Khoản,\nNông Trại & Khu Vực\n(Auth · User · Farm · Zone)\n[F01 – F03]" as BE_Core #EBDEF0
    component "Quản Lý Cảm Biến,\nUAV & Nhiệm Vụ Bay\n(Sensor · Uav · Mission)\n[F12 – F17]" as BE_Mission #EBDEF0
    component "Cảnh Báo Vượt Ngưỡng,\nEmail & Xuất Báo Cáo\n(AlertEngine · Email · Export)\n[F08 – F11]" as BE_Alert #EBDEF0
    component "Thu Nhận, Đồng Bộ &\nLọc Dữ Liệu Cảm Biến Rác\n(MqttGateway · Validator)\n[F18 – F20]" as BE_Ingest #D1F2EB

    component "Tầng Truy Xuất Cơ Sở Dữ Liệu\n(Spring Data JPA Repositories · Hibernate ORM)" as BE_JPA #FCF3CF

    BE_Core -[hidden]right- BE_Mission
    BE_Mission -[hidden]right- BE_Alert
    BE_Alert -[hidden]right- BE_Ingest

    BE_Security ..> BE_Core
    BE_Security ..> BE_Mission
    BE_Security ..> BE_Alert
    BE_Security ..> BE_Ingest

    BE_Ingest .left.> BE_Alert : quét ngưỡng
    BE_Core ..> BE_JPA
    BE_Mission ..> BE_JPA
    BE_Alert ..> BE_JPA
    BE_Ingest ..> BE_JPA
}

' =====================================================================
' TẦNG 3: THIẾT BỊ BIÊN & UAV MOBILE GATEWAY
' =====================================================================
package "3. Tầng Thiết Bị Biên & Trạm Thu Phát UAV (iot-simulator · Java 17)" as Layer3 #FEF5E7 {
    component "Thu Thập Số Liệu Cảm Biến\n& Mô Phỏng Hành Trình UAV\n(SensorData · UavFlightSimulator\n· WaypointMissionValidator)" as Edge_Sim #FDEBD0
    component "Quản Lý Lưu Tạm & Tự Động\nĐồng Bộ Bù Khi Mất Mạng\n(UavOfflineSyncManager ·\nOfflineStorageManager) [F20]" as Edge_Sync #F8C471
    component "Bộ Phát Tin MQTT\n& Cầu Nối Truyền Tải\n(MqttPublisher · QoS 1)" as Edge_Mqtt #FAD7A0
    database "Bộ Nhớ Đệm Ngoại Tuyến\n(SQLite: iot_offline.db)" as SQLite #FCF3CF

    Edge_Sim ..> Edge_Mqtt : gửi khi có mạng
    Edge_Sim ..> Edge_Sync : lưu khi mất mạng
    Edge_Sync ..> Edge_Mqtt : đẩy đồng bộ bù
    Edge_Sync ..> SQLite : đọc / ghi tạm
}

' =====================================================================
' TẦNG 4: CƠ SỞ DỮ LIỆU & DỊCH VỤ TRUNG GIAN
' =====================================================================
package "4. Tầng Lưu Trữ CSDL & Dịch Vụ Trung Gian" as Layer4 #FEF9E7 {
    database "CSDL Quan Hệ Trung Tâm\n(H2 In-Memory / MySQL 8.0)\n[users, farms, zones, sensors,\nsensor_data, uavs, missions, alerts]" as DB #F9E79F
    component "Dịch Vụ Thư Điện Tử\n(Gmail SMTP :587)" as SMTP #FADBD8
    queue "Trạm Trung Chuyển MQTT\n(HiveMQ Broker :1883 · QoS 1)\n[Kênh: iot/ltj/sensor/# · iot/ltj/sync/#]" as Broker #ABEBC6

    DB -[hidden]right- SMTP
    SMTP -[hidden]right- Broker
}

' =====================================================================
' KẾT NỐI LIÊN TẦNG (ZERO CROSSING)
' =====================================================================
FE_Gateway ..> BE_Security : "Gọi REST API + JWT (:8080/api/v1)\n& nhận luồng WebSocket / SSE"

BE_JPA ..> DB : "Đọc / Ghi CSDL\n(JDBC)"
BE_Alert ..> SMTP : "Gửi email cảnh báo\n(SMTP :587)"
BE_Ingest ..> Broker : "Đăng ký nhận tin\n(MQTT Subscribe :1883)"
Edge_Mqtt ..> Broker : "Đẩy số liệu đo & đồng bộ bù\n(MQTT Publish :1883 · QoS 1)"

@enduml
